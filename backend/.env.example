# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="file:./dev.db"

# ── Auth ─────────────────────────────────────────────────────────────────────
# Use a long, random value in production (e.g. `openssl rand -hex 32`)
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# Shared secret required to create an ADMIN account via /api/auth/admin-signup.
# Leave unset to disable admin self-registration entirely.
ADMIN_SIGNUP_SECRET=""

# ── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
CLIENT_URL="http://localhost:5173,http://localhost:5174"

# ── Email (optional — signup works without it) ────────────────────────────────
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
